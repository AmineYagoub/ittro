{
  "color": {
    "ink": "#0B0E13",
    "panel": "#161B23",
    "line": "#2A313C",
    "paper": "#F5F3EE",
    "muted": "#A9B1BD",
    "brand": "#2A62F0",
    "brandLight": "#7EA6FF",
    "brandPale": "#B8CCFF",
    "brandDeep": "#1E2A44",
    "yes": "#2BD98A",
    "yesInk": "#0A3B25",
    "no": "#B3261E",
    "notSure": "#FFB224",
    "notSureInk": "#3A2A06"
  },
  "verdict": {
    "yes": {
      "background": "#2BD98A",
      "text": "#0B0E13",
      "chipBorder": "#0B0E13"
    },
    "no": {
      "background": "#B3261E",
      "text": "#FFFFFF",
      "chipBorder": "rgba(255,255,255,0.7)"
    },
    "notSure": {
      "background": "#FFB224",
      "text": "#0B0E13",
      "chipBorder": "#0B0E13"
    }
  },
  "font": {
    "family": "Readex Pro",
    "expoPackage": "@expo-google-fonts/readex-pro",
    "spokenLine": {
      "size": 32,
      "weight": 600,
      "lineHeight": 1.3
    },
    "spokenLineArabic": {
      "size": 34,
      "weight": 600,
      "lineHeight": 1.4,
      "direction": "rtl"
    },
    "chip": {
      "size": 20,
      "weight": 500
    },
    "verdictWord": {
      "size": 48,
      "weight": 700
    }
  },
  "size": {
    "screenPadding": 24,
    "panelRadius": 28,
    "voiceIndicator": 60,
    "directionCircle": 64,
    "chipHeight": 44,
    "targetStroke": 5,
    "targetHalo": 11,
    "readingStroke": 4,
    "readingDash": [
      10,
      8
    ]
  },
  "haptics": {
    "yes": [
      0,
      60,
      80,
      60
    ],
    "no": [
      0,
      120,
      90,
      120,
      90,
      120
    ],
    "notSure": [
      0,
      400
    ],
    "proximityTick": {
      "pulse": 30,
      "slowestGapMs": 600,
      "fastestGapMs": 120
    }
  },
  "speech": {
    "defaultLanguage": "en",
    "languages": [
      "en",
      "ar",
      "fr"
    ],
    "lineStartsWithinMs": 300,
    "maxWaitBeforeNewLineMs": 3000,
    "working": {
      "tickEveryMs": 2000,
      "firstUpdateMs": 4000,
      "updateEveryMs": 8000
    },
    "waiting": {
      "askAgainMs": 8000,
      "offerHelpMs": 20000,
      "reminderEveryMs": 60000
    },
    "guiding": {
      "directionHoldMs": 400,
      "directionRepeatMs": 6000,
      "noHandRepeatMs": 6000,
      "cues": {
        "newDirection": "hand_<dir>",
        "underOneHandWidth": "hand_<dir>_small",
        "sameDirectionAtRepeat": "hand_<dir>_continue"
      },
      "numberedDistances": false,
      "axisOrder": [
        "leftRight",
        "upDown"
      ],
      "almostThereOncePerApproach": true,
      "wordsStopWhenClose": true,
      "reachForwardAfterHoverMs": 1000,
      "pickUpNeedsContactEvidence": [
        "says got it",
        "earbud press once",
        "outline moves with the hand"
      ]
    },
    "notSure": {
      "rereadEveryMs": 1200,
      "maxRereads": 5
    },
    "heardSoundWithinMs": 300,
    "maxWordsPerLine": 12,
    "verbosity": {
      "default": "short",
      "options": [
        "short",
        "detailed"
      ]
    },
    "searching": {
      "rescanOnPanPercent": 30,
      "giveUpAfterSweep": true,
      "sweepTooFastSayOnce": true
    },
    "speed": {
      "speculativeReadRestMs": 500,
      "sharpestFrameWindowMs": 450,
      "directionClipStartMs": 50,
      "firstOutlineAfterYesMs": 3000,
      "findTargetMs": 30000,
      "queueOrder": [
        "heldProduct",
        "shopperQuestion",
        "recoverTarget",
        "firstShelfReads",
        "otherReads"
      ],
      "startSearchDuringConfirm": true
    },
    "language": {
      "transcribeLanguageBias": [
        "English",
        "Arabic",
        "French"
      ],
      "firstLaunchListenMs": 5000,
      "firstLaunchWords": {
        "ar": "عربي",
        "fr": "français"
      },
      "repeatMicLineInPhoneLanguage": [
        "ar",
        "fr"
      ],
      "offerOncePerSession": true,
      "remembered": true
    }
  },
  "sounds": {
    "folder": "sounds/",
    "format": "WAV, 16-bit mono, 44.1 kHz; peak level is already set in each file, so play every sound at the same volume",
    "heard": {
      "file": "heard.wav",
      "meaning": "one short soft note within 0.3 s of the shopper finishing"
    },
    "listening": {
      "file": "listening.wav",
      "meaning": "two rising notes when the microphone opens for an answer"
    },
    "working": {
      "file": "working-tick.wav",
      "meaning": "soft tick every 2 s while working"
    },
    "trackingLost": {
      "file": "lost.wav",
      "meaning": "low falling note; directions stop until tracking is back"
    },
    "proximity": {
      "file": "proximity-tick.wav",
      "meaning": "played with each 30 ms vibration pulse; gap 600 to 120 ms"
    },
    "helperWait": {
      "file": "helper-pulse.wav",
      "meaning": "soft pulse every 5 s after the first 10 s of waiting for a helper"
    },
    "pausing": {
      "file": "pausing.wav",
      "meaning": "three falling notes before \"I'm pausing\" (screen 26)"
    },
    "waking": {
      "file": "waking.wav",
      "meaning": "three rising notes when Ittro wakes from a pause"
    },
    "yes": {
      "file": "yes.wav",
      "meaning": "chime up, with the yes vibration and the first word"
    },
    "no": {
      "file": "no.wav",
      "meaning": "chime down, with the no vibration and the first word"
    },
    "notSure": {
      "file": "not-sure.wav",
      "meaning": "single low wavering note, with the long vibration"
    }
  },
  "buttons": {
    "holdMs": 800,
    "multiPressWindowMs": 450,
    "earbud": {
      "once": "yesOrRepeat",
      "twice": "no",
      "nextTrack": "no",
      "threeTimes": "help",
      "previousTrack": "help",
      "hold": "stopOrWake"
    },
    "volumeDownHold": "stopOrWakeAndRepeat",
    "neverUseBothVolumeKeys": true
  },
  "helper": {
    "pairCodeDigits": 6,
    "pairCodeExpiresMin": 10,
    "waitTickEveryMs": 2000,
    "waitTickForMs": 10000,
    "waitPulseEveryMs": 5000,
    "waitUpdateEveryMs": 30000,
    "giveUpAfterMs": 300000,
    "photoKeptMaxMin": 30,
    "offerAfterUnreadable": 2,
    "firstAnswerWins": true,
    "confirmBeforeSend": true
  },
  "phone": {
    "minVolumeAtStartPercent": 30,
    "raiseVolumeToPercent": 50,
    "keepScreenOnWhileActive": true,
    "pauseOnLockCallOrAudioFocusLoss": true,
    "lowBatteryPercent": 15,
    "idleListenAfterDoneMs": 120000,
    "speechRate": {
      "default": 1.0,
      "min": 0.7,
      "max": 2.0,
      "step": 0.15
    }
  },
  "shop": {
    "nearestOf": "largest and most central outline",
    "offerCloseAlternative": true,
    "alternativeOutline": "brandLight dashed until yes",
    "listNextLine": "Next: {name}."
  },
  "firstLaunch": [
    "permissions",
    "chooseLanguage",
    "privacy",
    "volumeKeyHint",
    "soundTourOffer",
    "welcome"
  ],
  "voice": {
    "folder": "voice/",
    "script": "voice/SCRIPT.md",
    "clipList": "voice/clips.json",
    "file": "<id>.<lang>.wav",
    "en": {
      "engine": "mms",
      "model": "facebook/mms-tts-eng",
      "onnx": "Xenova/mms-tts-eng",
      "clipsShipped": true
    },
    "fr": {
      "engine": "mms",
      "model": "facebook/mms-tts-fra",
      "onnx": "Xenova/mms-tts-fra",
      "clipsShipped": true
    },
    "ar": {
      "engine": "phone",
      "clipsMadeOnFirstLaunch": true
    },
    "mms": {
      "sampleRate": 16000,
      "seed": 0,
      "pauseAfterSentenceMs": 300,
      "pauseAfterCommaMs": 120,
      "splitAt": ".,:?!",
      "licence": "CC-BY-NC-4.0",
      "fallbackIfSentenceSynthMsOver": 1000
    }
  }
}
