{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/v17.6.0/schemas/config.json",
  "bump-minor-pre-major": true,
  "include-component-in-tag": false,
  "initial-version": "0.1.0",
  "changelog-sections": [
    { "type": "feat", "section": "New" },
    { "type": "fix", "section": "Fixed" },
    { "type": "perf", "section": "Changed" },
    { "type": "revert", "section": "Changed" }
  ],
  "packages": {
    ".": {
      "release-type": "simple",
      "changelog-path": "CHANGELOG.md",
      "extra-files": ["app/app.config.ts", { "type": "json", "path": "relay/package.json", "jsonpath": "$.version" }]
    }
  }
}
